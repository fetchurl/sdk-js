#!/usr/bin/env bash
set -euo pipefail

# Usage: ./make_release [next|major|minor|patch|<x.y.z>]
# Computes version with svu (from git tags + conventional commits), writes package.json.
MODE="${1:-next}"

case "$MODE" in
  next|major|minor|patch)
    TAG="$(svu "$MODE")"
    ;;
  *)
    # explicit semver (with or without leading v)
    TAG="${MODE#v}"
    TAG="v$TAG"
    ;;
esac

VERSION="${TAG#v}"

node -e "
const fs = require('fs');
const p = JSON.parse(fs.readFileSync('package.json', 'utf8'));
p.version = process.argv[1];
fs.writeFileSync('package.json', JSON.stringify(p, null, 2) + '\n');
" "$VERSION"

git add package.json
git commit -sm "bump to $VERSION" || true
if [[ ! -v NO_TAG ]]; then
  git tag "$TAG"
  git push origin "$TAG"
fi
git push origin HEAD

echo "$VERSION"
